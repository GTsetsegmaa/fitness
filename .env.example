# Copy to .env and fill in. .env is gitignored: never commit real values.
#   cp .env.example .env

# Postgres password, used by docker compose for the db service.
# Use letters and digits only (it goes inside a URL). Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Used by `npm run dev` and `npm run db:*` on your machine (Postgres from `docker compose up -d db`).
# Inside Docker, compose builds its own URL pointing at the db service instead.
DATABASE_URL=postgres://fitness:change-me@localhost:5433/fitness

# Domain Caddy serves and gets an HTTPS certificate for. localhost for local testing.
DOMAIN=localhost
